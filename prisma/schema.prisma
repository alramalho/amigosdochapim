generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  APOIANTE
  AMIGO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  INCOMPLETE
}

enum DonationType {
  ONE_OFF
  SUBSCRIPTION
}

enum ContestStatus {
  DRAFT
  APPLICATIONS_OPEN
  INITIAL_REVIEW
  FINAL_MATERIALS
  JURY_REVIEW
  COMPLETED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  SELECTED_FOR_FINAL
  FINAL_MATERIALS_SUBMITTED
  FINALIST
  WINNER
  REJECTED
}

enum InterviewAvailabilityChoice {
  YES
  IF_NEEDED
  NO
}

enum SubmissionFilePurpose {
  CV
  FINAL_MATERIAL
}

enum EmailSendStatus {
  QUEUED
  SENDING
  SENT
  PARTIALLY_SENT
  FAILED
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  ACCEPTED
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  supabaseId       String?  @unique @map("supabase_id")
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subscription    Subscription?
  donations       Donation[]
  submissions     Submission[]
  submissionFiles SubmissionFile[]
  juryReviews     JuryReview[]
  juryRankings    JuryRanking[]

  @@map("users")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  tier                 SubscriptionTier
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Donation {
  id                    String       @id @default(cuid())
  userId                String       @map("user_id")
  type                  DonationType @default(ONE_OFF)
  amount                Int // Amount in cents
  stripePaymentIntentId String?      @unique @map("stripe_payment_intent_id")
  stripeInvoiceId       String?      @unique @map("stripe_invoice_id")
  createdAt             DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("donations")
}

model Contest {
  id                    String        @id @default(cuid())
  title                 String
  slug                  String        @unique
  status                ContestStatus @default(DRAFT)
  applicationsOpenAt    DateTime      @map("applications_open_at")
  applicationsCloseAt   DateTime      @map("applications_close_at")
  finalMaterialsOpenAt  DateTime      @map("final_materials_open_at")
  finalMaterialsCloseAt DateTime      @map("final_materials_close_at")
  juryReviewOpenAt      DateTime      @map("jury_review_open_at")
  juryReviewCloseAt     DateTime      @map("jury_review_close_at")
  productionStartsAt    DateTime      @map("production_starts_at")
  productionEndsAt      DateTime      @map("production_ends_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  submissions  Submission[]
  juryRankings JuryRanking[]

  @@map("contests")
}

model Submission {
  id                 String           @id @default(cuid())
  contestId          String           @map("contest_id")
  userId             String           @map("user_id")
  status             SubmissionStatus @default(SUBMITTED)
  isTest             Boolean          @default(false) @map("is_test")
  candidateName      String           @map("candidate_name")
  age                Int
  email              String
  phone              String
  residentInPortugal Boolean          @default(false) @map("resident_in_portugal")
  cvUrl              String?          @map("cv_url")
  motivation         String
  synopsis           String
  plotPoints         String           @map("plot_points")
  scriptSummary      String           @map("script_summary")
  visualIdeas        String           @map("visual_ideas")
  externalLinks      String?          @map("external_links")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  contest        Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalMaterials SubmissionFinalMaterials?
  files          SubmissionFile[]
  juryReviews    JuryReview[]

  @@unique([contestId, userId])
  @@map("submissions")
}

model SubmissionFinalMaterials {
  id                 String   @id @default(cuid())
  submissionId       String   @unique @map("submission_id")
  materialList       String   @map("material_list")
  budgetPlan         String   @map("budget_plan")
  productionCalendar String   @map("production_calendar")
  externalLinks      String?  @map("external_links")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_final_materials")
}

model SubmissionFile {
  id           String                @id @default(cuid())
  submissionId String                @map("submission_id")
  userId       String                @map("user_id")
  purpose      SubmissionFilePurpose
  bucket       String
  objectKey    String                @map("object_key")
  publicUrl    String                @map("public_url")
  fileName     String                @map("file_name")
  contentType  String                @map("content_type")
  sizeBytes    Int                   @map("size_bytes")
  createdAt    DateTime              @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectKey])
  @@map("submission_files")
}

model JuryReview {
  id              String   @id @default(cuid())
  submissionId    String   @map("submission_id")
  jurorId         String   @map("juror_id")
  artisticQuality Int?     @map("artistic_quality")
  originality     Int?
  argumentClarity Int?     @map("argument_clarity")
  aestheticVision Int?     @map("aesthetic_vision")
  budgetViability Int?     @map("budget_viability")
  motivation      Int?
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  juror      User       @relation(fields: [jurorId], references: [id], onDelete: Cascade)

  @@unique([submissionId, jurorId])
  @@map("jury_reviews")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  // Coarse, IP-derived estimate (no raw IP stored).
  country   String?
  region    String?
  city      String?
  // Precise location, only stored with explicit opt-in consent.
  latitude  Float?
  longitude Float?
  precise   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([path])
  @@index([createdAt])
  @@index([country])
  @@map("page_views")
}

model EmailDraft {
  id                  String    @id @default(cuid())
  name                String
  subject             String
  previewText         String?   @map("preview_text")
  body                String
  audienceSegments    String[]  @map("audience_segments")
  recipientEmail      String?   @map("recipient_email")
  recipientSelections String[]  @default([]) @map("recipient_selections")
  createdByEmail      String    @map("created_by_email")
  sentByEmail         String?   @map("sent_by_email")
  sentAt              DateTime? @map("sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  emailSend EmailSend?

  @@index([updatedAt])
  @@map("email_drafts")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String
  pagePath       String?   @map("page_path")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([unsubscribedAt])
  @@map("newsletter_subscribers")
}

model EmailSend {
  id                  String              @id @default(cuid())
  draftId             String              @unique @map("draft_id")
  name                String
  subject             String
  previewText         String?             @map("preview_text")
  body                String
  audienceSegments    String[]            @map("audience_segments")
  recipientEmail      String?             @map("recipient_email")
  recipientSelections String[]            @default([]) @map("recipient_selections")
  fromEmail           String              @map("from_email")
  status              EmailSendStatus     @default(QUEUED)
  recipientCount      Int                 @map("recipient_count")
  acceptedCount       Int                 @default(0) @map("accepted_count")
  deliveredCount      Int                 @default(0) @map("delivered_count")
  failedCount         Int                 @default(0) @map("failed_count")
  archiveStatus       EmailDeliveryStatus @default(QUEUED) @map("archive_status")
  archiveMessageId    String?             @unique @map("archive_message_id")
  archiveClaimToken   String?             @map("archive_claim_token")
  archiveClaimedAt    DateTime?           @map("archive_claimed_at")
  archiveError        String?             @map("archive_error")
  archivedAt          DateTime?           @map("archived_at")
  createdByEmail      String              @map("created_by_email")
  startedAt           DateTime?           @map("started_at")
  completedAt         DateTime?           @map("completed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  draft      EmailDraft      @relation(fields: [draftId], references: [id])
  deliveries EmailDelivery[]

  @@index([createdAt])
  @@index([status])
  @@map("email_sends")
}

model EmailDelivery {
  id                String              @id @default(cuid())
  sendId            String              @map("send_id")
  email             String
  name              String?
  audienceSegments  String[]            @map("audience_segments")
  topicName         String?             @map("topic_name")
  status            EmailDeliveryStatus @default(QUEUED)
  providerMessageId String?             @unique @map("provider_message_id")
  claimToken        String?             @map("claim_token")
  error             String?
  attempts          Int                 @default(0)
  acceptedAt        DateTime?           @map("accepted_at")
  deliveredAt       DateTime?           @map("delivered_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  send EmailSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  @@unique([sendId, email])
  @@index([sendId, status])
  @@map("email_deliveries")
}

model JuryRanking {
  id                   String    @id @default(cuid())
  contestId            String    @map("contest_id")
  jurorId              String    @map("juror_id")
  orderedSubmissionIds String[]  @map("ordered_submission_ids")
  submittedAt          DateTime? @map("submitted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  juror   User    @relation(fields: [jurorId], references: [id], onDelete: Cascade)

  @@unique([contestId, jurorId])
  @@map("jury_rankings")
}

model InterviewAvailability {
  id         String                      @id @default(cuid())
  jurorEmail String                      @map("juror_email")
  slotStart  DateTime                    @map("slot_start")
  choice     InterviewAvailabilityChoice
  createdAt  DateTime                    @default(now()) @map("created_at")
  updatedAt  DateTime                    @updatedAt @map("updated_at")

  @@unique([jurorEmail, slotStart])
  @@index([slotStart])
  @@map("interview_availability")
}
